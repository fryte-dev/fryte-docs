{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "FRYTE API",
  "colors": {
    "primary": "#F57C00",
    "light": "#F57C00",
    "dark": "#F57C00"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Planner",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "planner/quickstart",
              "planner/vehicles",
              "planner/errors",
              "planner/limitations",
              "planner/mcp"
            ]
          },
          {
            "group": "Example Routes",
            "pages": [
              "planner/examples/intermediate-stops",
              "planner/examples/multiday-tour",
              "planner/examples/time-windows",
              "planner/examples/minimum-charge-duration",
              "planner/examples/search-corridor"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "POST /planner/v2",
              "GET /planner/jobs/{job_id}",
              "GET /planner/jobs",
              "GET /planner/optimizations/{optimization_id}/result"
            ]
          }
        ]
      }
    ]
  },
  "logo": "/logo/light.svg",
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:team@fryte.eu"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "/#authentication"
    }
  },
  "api": {
    "examples": {
      "languages": ["bash", "python", "javascript", "typescript", "csharp", "php", "java", "go", "kotlin"]
    }
  },
  "contextual": {
    "options": ["copy"]
  },
  "footer": {
    "socials": {
      "website": "https://fryte.com/en",
      "linkedin": "https://www.linkedin.com/company/fryte-mobility/posts/"
    }
  }
}
